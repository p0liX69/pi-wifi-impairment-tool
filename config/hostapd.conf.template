# hostapd configuration — generated by setup.sh from this template.
# Edit config.env to change SSID/passphrase, then re-run setup.sh.

interface=__AP_IFACE__
driver=nl80211
ssid=__WIFI_SSID__
country_code=__WIFI_COUNTRY_CODE__

# 2.4GHz 802.11n — safer default across all Pi 5 board revisions.
# To try 5GHz: set hw_mode=a, channel=36 (or 40/44/48), ieee80211ac=1.
hw_mode=g
channel=__WIFI_CHANNEL__
ieee80211n=1
ieee80211d=1
wmm_enabled=1

macaddr_acl=0
auth_algs=1
ignore_broadcast_ssid=0

wpa=2
wpa_passphrase=__WIFI_PASSPHRASE__
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
