# Copy this to config.env and fill in your values before running setup.sh.
# config.env is gitignored — never commit it.

WIFI_SSID="PiImpair"
WIFI_PASSPHRASE="changeme123"
WIFI_CHANNEL=6
WIFI_COUNTRY_CODE="US"

# Interface names (change only if your Pi uses different names)
WAN_IFACE="eth0"
AP_IFACE="wlan0"
AP_SUBNET="192.168.50"
AP_IP="192.168.50.1"
DHCP_RANGE_START="192.168.50.100"
DHCP_RANGE_END="192.168.50.200"

# Web UI port
CONTROL_PORT=8080

# PCIe M.2 WiFi HAT (e.g. ZDE ZP590A with Intel BE200/AX210/AX200 or MediaTek MT7922).
#   auto → detect the M.2 card, enable the Pi 5 PCIe port, install firmware,
#          and use the card as the access point when it supports AP mode.
#          Falls back to AP_IFACE above if no usable card is found.
#   off  → ignore any M.2 card and always use the built-in WiFi (AP_IFACE).
PCIE_WIFI="auto"

# PCIe link speed for the M.2 slot: 2 (Gen2, safe default) or 3 (Gen3, faster but uncertified).
PCIE_WIFI_GEN=2
